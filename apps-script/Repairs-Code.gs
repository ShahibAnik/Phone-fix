/* COMPLETE replacement for the Repairs (Tokens) Apps Script project's Code.gs.
   Keep the Inventory project separate. Existing endpoints and A-Z columns are preserved.
   Team credentials remain in Supabase; never put PIN/recovery hashes in a public Sheet.
   ID rename is refused until a transaction-capable service covers BOTH backends. */
var SHEET_NAME='Repairs', NCOLS=26;
var FIELDS=['ticketId','customerName','phone','deviceModel','passcode','price','priceFormatted','paymentStatus','fixedBy','notes','dateTime','createdAtMs','status','statusChangedAt','customerId','subtotal','taxAmount','isTaxable','warrantyDays','queueSerial','queueDay','priority','readyBy','readyByLabel','deliveredDay','rating'];
var C={statusChangedAt:13,customerId:14,warrantyDays:18};
function has_(v){return v!=null&&v!=='';}
function sheet_(){var ss=SpreadsheetApp.getActiveSpreadsheet();return ss.getSheetByName(SHEET_NAME)||ss.insertSheet(SHEET_NAME);}
function jsonOut_(o){return ContentService.createTextOutput(JSON.stringify(o)).setMimeType(ContentService.MimeType.JSON);}
function doPost(e){var lock=LockService.getScriptLock();try{var p=JSON.parse(e.postData.contents);if(p.recordType==='renameIds')return jsonOut_({ok:false,error:'ID rename blocked: the separate Repairs and PartUsage backends do not share an atomic transaction. No records were changed.'});if(p.recordType==='team')return pfTeam_(p);lock.waitLock(20000);if(p.recordType==='warranty')return warrantySync_(p);if(p.recordType==='repair')upsertRepair_(p);else appendLegacyIntake_(p);return jsonOut_({ok:true});}catch(err){return jsonOut_({ok:false,error:String(err.message||err)});}finally{if(lock.hasLock())lock.releaseLock();}}
function appendLegacyIntake_(p){var row=[p.id||'',p.name||'',p.phone||'',p.device||'',p.code||'',p.price==null?'':p.price,p.priceFormatted||'',p.isPaid?'PAID':'DUE',p.fixedBy||'',p.notes||'',p.dateDisplay||'',p.createdAt||'','Queued',''];while(row.length<NCOLS)row.push('');sheet_().appendRow(row);}
function buildRow_(p,status){var row=FIELDS.map(function(f){return has_(p[f])?p[f]:'';});row[12]=status;return row;}
function epoch_(v){if(v instanceof Date)return v.getTime();var n=Date.parse(String(v||''));return isFinite(n)?n:0;}
function upsertRepair_(p){var sh=sheet_(),id=String(p.ticketId||'');if(!id)return;var now=new Date(),status=String(p.status||'Queued'),vals=sh.getDataRange().getValues();for(var i=1;i<vals.length;i++){if(String(vals[i][0])!==id)continue;if(p.deleted){sh.deleteRow(i+1);return;}var row=buildRow_(p,status),cur=vals[i];
 // Compare stored STATUS (M), not stored timestamp (N). Older status updates cannot win.
 var incoming=epoch_(p.statusChangedAt),stored=epoch_(cur[C.statusChangedAt]);
 if(incoming&&stored&&incoming<stored){row[12]=cur[12];row[C.statusChangedAt]=cur[C.statusChangedAt];}else row[C.statusChangedAt]=p.statusChangedAt||(String(cur[12]||'')!==status?now:(cur[C.statusChangedAt]||''));
 for(var ci=C.customerId;ci<NCOLS;ci++)if(!has_(p[FIELDS[ci]]))row[ci]=ci<cur.length&&cur[ci]!=null?cur[ci]:'';
 sh.getRange(i+1,1,1,NCOLS).setValues([row]);return;}if(p.deleted)return;var row2=buildRow_(p,status);row2[C.statusChangedAt]=p.statusChangedAt||now;sh.appendRow(row2);}
function warrantySync_(p){var sh=sheet_(),last=sh.getLastRow();if(last<2)return jsonOut_({ok:true,updated:0});var ids=sh.getRange(2,1,last-1,1).getValues(),updated=0;((p&&p.rows)||[]).forEach(function(r){var id=String(r&&r.ticketId||''),w=r?r.warrantyDays:null;if(!id||!has_(w))return;for(var i=0;i<ids.length;i++)if(String(ids[i][0])===id){if(p.onlyIfBlank){var cur=sh.getRange(i+2,C.warrantyDays+1).getValue();if(cur!==''&&cur!=null)break;}sh.getRange(i+2,C.warrantyDays+1).setValue(w);updated++;break;}});return jsonOut_({ok:true,updated:updated});}
function doGet(e){if(e&&e.parameter&&e.parameter.action==='repairs')return repairsGet_();return ContentService.createTextOutput('ok');}
function repairsGet_(){var vals=sheet_().getDataRange().getValues(),out=[];for(var i=1;i<vals.length;i++){var r=vals[i];if(!String(r[0]||'').trim())continue;var o={};FIELDS.forEach(function(f,ci){o[f]=ci<r.length&&r[ci]!=null?r[ci]:'';});o.ticketId=String(r[0]);o.status=o.status||'Queued';o.statusChangedAt=fmtDT_(o.statusChangedAt);o.warrantyDays=has_(o.warrantyDays)?Number(o.warrantyDays):'';o.intakeAt='';o.reviewText='';out.push(o);}return jsonOut_(out);}
function fmtDT_(v){if(Object.prototype.toString.call(v)==='[object Date]'&&!isNaN(v)){var p2=function(n){return String(n).padStart(2,'0');};return v.getFullYear()+'-'+p2(v.getMonth()+1)+'-'+p2(v.getDate())+' '+p2(v.getHours())+':'+p2(v.getMinutes());}return v||'';}
// Team reads and writes are authenticated; the original legacy repair contract remains compatible.
function pfTeam_(p){if(!p.accessToken)throw new Error('Sign in to manage team access');var name=p.action==='list'?'pf_team_list':p.action==='save'?'pf_team_save':null;if(!name)throw new Error('Unknown team action');var r=UrlFetchApp.fetch('https://nqmpplbddzigosyzwmbt.supabase.co/rest/v1/rpc/'+name,{method:'post',contentType:'application/json',headers:{apikey:'sb_publishable_6LnFNGQR3dGBDWOGjF1ubg_pM3QODMl',Authorization:'Bearer '+p.accessToken},payload:JSON.stringify(name==='pf_team_list'?{}:{payload:p.member}),muteHttpExceptions:true});if(r.getResponseCode()<200||r.getResponseCode()>=300)throw new Error('Team operation refused by Supabase');return jsonOut_({ok:true,data:JSON.parse(r.getContentText()||'null')});}
