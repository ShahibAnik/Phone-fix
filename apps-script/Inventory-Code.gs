/* COMPLETE replacement for the Inventory project's Code.gs. Do NOT paste into Repairs.
   Existing tab/header names, aliases, key matching, payment serialization and endpoints stay compatible.
   PINs, recovery hashes and account permissions are stored privately in Supabase. */
var TAB_INV='Inventory',TAB_SO='SpecialOrders',TAB_CRED='StoreCredit',TAB_PARTS='Parts',TAB_USAGE='PartUsage',TAB_ACC='Accessories',TAB_ORDER='ToOrder';
var INV_COLS={'IMEI':'imei','Product Name':'name','Storage':'storage','Buying Price':'price','Qty':'qty','Dealer':'dealer','Date':'date','Status':'status','Sold Price':'soldPrice','Sold Date':'soldDate','Customer Name':'custName','Customer Phone':'custPhone','Agreed Price':'layAgreed','Layaway Customer':'layCustomer','Layaway Phone':'layPhone','Payments':'layPayments','Layaway Status':'layStatus'};
var INV_EXTRA=['Lot Total','Total Buying','Profit'];
var SO_COLS={'ID':'id','Customer':'customer','Phone':'phone','Item':'item','Specs':'specs','Total Price':'total','Deposit':'deposit','Deposit Date':'depDate','Expected Date':'expected','Status':'status','Notes':'notes','Payments':'payments','Created At':'createdAt'};
var CRED_COLS={'ID':'id','Customer':'customer','Phone':'phone','Amount':'amount','Date Issued':'issued','Description':'desc','Uses':'uses','Created At':'createdAt'};
var PARTS_COLS={'SKU':'sku','Brand':'brand','Phone Model':'model','Part Type':'type','Grade':'grade','Qty':'qty','Unit Cost':'cost','Supplier':'sup','Low At':'low','Notes':'notes','Date Added':'date','Color':'color','Section':'section'};
var ACC_COLS={'SKU':'sku','Brand':'brand','Model':'model','Section':'section','Color':'color','Qty':'qty','Unit Cost':'cost','Supplier':'sup','Low At':'low','Notes':'notes','Date Added':'date'};
var ORDER_COLS={'SKU':'sku','Qty':'qty'};
var USAGE_COLS={'Usage ID':'id','Date':'date','Ticket ID':'ticketId','SKU':'sku','Brand':'brand','Phone Model':'model','Part Type':'type','Color':'color','Qty':'qty','Unit Cost':'cost'};
function json_(o){return ContentService.createTextOutput(JSON.stringify(o)).setMimeType(ContentService.MimeType.JSON);}
function sheet_(name){var ss=SpreadsheetApp.getActiveSpreadsheet();return ss.getSheetByName(name)||ss.insertSheet(name);}
function ensureHeader_(sh,cols,extra){var want=Object.keys(cols).concat(extra||[]),lastCol=Math.max(want.length,sh.getLastColumn()),head=sh.getRange(1,1,1,lastCol).getValues()[0].map(function(c){return String(c).trim();});if(head.every(function(c){return c==='';})){sh.getRange(1,1,1,want.length).setValues([want]);sh.setFrozenRows(1);try{sh.getRange(1,1,1,want.length).setFontWeight('bold');}catch(e){}}else{var missing=want.filter(function(h){return head.indexOf(h)<0;});if(missing.length){var start=sh.getLastColumn()+1;sh.getRange(1,start,1,missing.length).setValues([missing]);try{sh.getRange(1,start,1,missing.length).setFontWeight('bold');}catch(e){}}}return sh.getRange(1,1,1,sh.getLastColumn()).getValues()[0].map(function(c){return String(c).trim();});}
function cellVal_(v){if(v==null)return '';if(typeof v==='object')return JSON.stringify(v);if(typeof v==='number'&&v>946684800000&&v<4102444800000)try{return Utilities.formatDate(new Date(v),Session.getScriptTimeZone(),'yyyy-MM-dd HH:mm');}catch(e){}return v;}
function findRow_(sh,keyCol,key){if(!key)return -1;var last=sh.getLastRow();if(last<2)return -1;var vals=sh.getRange(2,keyCol,last-1,1).getValues(),ks=String(key).trim().toLowerCase();for(var i=0;i<vals.length;i++)if(String(vals[i][0]).trim().toLowerCase()===ks)return i+2;return -1;}
function upsert_(tabName,cols,extra,keyField,body){var sh=sheet_(tabName),head=ensureHeader_(sh,cols,extra),colIdx={};head.forEach(function(h,i){if(h)colIdx[h]=i+1;});var keyHeader=Object.keys(cols).filter(function(h){return cols[h]===keyField;})[0],key=body[keyField];if(!key)return json_({ok:false,error:'missing '+keyField});var existing=findRow_(sh,colIdx[keyHeader],key);if(body.deleted===true||String(body.deleted).toLowerCase()==='true'){if(existing>0)sh.deleteRow(existing);return json_({ok:true,deleted:true});}var row=head.map(function(){return '';});Object.keys(cols).forEach(function(h){var ci=colIdx[h];if(ci)row[ci-1]=cellVal_(body[cols[h]]);});if(tabName===TAB_INV){var price=parseFloat(body.price)||0,sp=parseFloat(body.soldPrice);if(colIdx.Profit&&isFinite(sp))row[colIdx.Profit-1]=(sp-price).toFixed(2);}if(existing>0)sh.getRange(existing,1,1,head.length).setValues([row]);else sh.appendRow(row);return json_({ok:true,updated:existing>0});}
function upsertUsage_(body){return upsert_(TAB_USAGE,USAGE_COLS,null,'id',body);}
function rows_(tabName,cols){var sh=sheet_(tabName),last=sh.getLastRow();if(last<2)return [];var head=sh.getRange(1,1,1,sh.getLastColumn()).getValues()[0].map(function(c){return String(c).trim();}),vals=sh.getRange(2,1,last-1,head.length).getValues(),out=[];vals.forEach(function(r){var o={};head.forEach(function(h,i){if(cols[h])o[cols[h]]=r[i];});if(o.id||o.imei||o.sku)out.push(o);});return out;}
function aliasPart_(b){if(b.type==null)b.type=b.partType;if(b.cost==null)b.cost=b.unitCost;if(b.sup==null)b.sup=b.supplier;if(b.low==null)b.low=b.lowAt;if(b.date==null)b.date=b.dateAdded;if(b.model==null)b.model=b.phoneModel;if(b.notes==null)b.notes=b.note;if(b.section==null)b.section=b.subcategory;return b;}
function aliasAcc_(b){if(b.section==null)b.section=b.subcategory;if(b.cost==null)b.cost=b.unitCost;if(b.sup==null)b.sup=b.supplier;if(b.low==null)b.low=b.lowAt;if(b.date==null)b.date=b.dateAdded;if(b.model==null)b.model=b.fitsModel;if(b.notes==null)b.notes=b.note;return b;}
function doPost(e){var lock=LockService.getScriptLock();try{var body=JSON.parse(e.postData.contents),t=String(body.recordType||'');if(t==='renameIds')return json_({ok:false,error:'ID rename blocked: Repairs and PartUsage do not share an atomic transaction. No records were changed.'});lock.waitLock(20000);if(t==='specialOrder')return upsert_(TAB_SO,SO_COLS,null,'id',body);if(t==='storeCredit')return upsert_(TAB_CRED,CRED_COLS,null,'id',body);if(t==='part')return upsert_(TAB_PARTS,PARTS_COLS,null,'sku',aliasPart_(body));if(t==='partUsage')return upsertUsage_(body);if(t==='accessory')return upsert_(TAB_ACC,ACC_COLS,null,'sku',aliasAcc_(body));if(t==='toOrder')return upsert_(TAB_ORDER,ORDER_COLS,null,'sku',body);return upsert_(TAB_INV,INV_COLS,INV_EXTRA,'imei',body);}catch(err){return json_({ok:false,error:String(err.message||err)});}finally{if(lock.hasLock())lock.releaseLock();}}
function doGet(e){var a=String(e&&e.parameter&&e.parameter.action||'').toLowerCase();if(a==='specialorders'||a==='special_orders')return json_(rows_(TAB_SO,SO_COLS));if(a==='storecredit'||a==='store_credit')return json_(rows_(TAB_CRED,CRED_COLS));if(a==='parts')return json_(rows_(TAB_PARTS,PARTS_COLS));if(a==='usage')return json_(rows_(TAB_USAGE,USAGE_COLS));if(a==='accessories'||a==='accessory')return json_(rows_(TAB_ACC,ACC_COLS));if(a==='toorder'||a==='to_order')return json_(rows_(TAB_ORDER,ORDER_COLS));return json_(rows_(TAB_INV,INV_COLS));}
